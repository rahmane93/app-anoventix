# =============================================================================
# Spring Profile (dev | prod)
# =============================================================================
# - dev  : ddl-auto=update, logs DEBUG, métriques actuator complètes
# - prod : ddl-auto=validate, logs INFO/WARN, /actuator/health uniquement
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=immodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB_URL=jdbc:postgresql://localhost:5432/immodb
POSTGRES_BD_SCHEMA=public

# =============================================================================
# SMTP
# =============================================================================
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username@domain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@anoventix.com

# =============================================================================
# JWT
# =============================================================================
# Doit faire au moins 32 octets (256 bits) — ex : openssl rand -base64 48
JWT_SECRET_KEY=change_me_to_a_strong_random_secret_at_least_32_bytes_long
JWT_EXPIRATION=900000              # access token : 15 min
JWT_REFRESH_EXPIRATION=604800000   # refresh token : 7 jours

# =============================================================================
# Application
# =============================================================================
APP_BASE_URL=http://localhost:8080
APP_UPLOAD_DIR=./uploads
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8081

# Mettre à true UNIQUEMENT si l'API est derrière un reverse-proxy de confiance
# (nginx, Traefik) qui positionne X-Forwarded-For. Sinon false (anti-spoofing).
TRUST_XFF=false

# =============================================================================
# Sécurité
# =============================================================================
APP_SECURITY_BCRYPT_STRENGTH=12

# =============================================================================
# Compte admin créé au 1er démarrage si la base ne contient pas d'admin
# =============================================================================
ADMIN_EMAIL=admin@anoventix.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# =============================================================================
# Licence annuelle (mode activé par l'administrateur depuis l'app)
# =============================================================================
# Annonces actives gratuites par compte avant licence obligatoire
LICENCE_ANNONCES_GRATUITES=5

# URL de l'API backend (production)
# EXPO_PUBLIC_API_URL=https://api.anoventix.com

# En dev avec un téléphone physique, utiliser l'IP locale de la machine
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:80

# En dev avec émulateur Android, 10.0.2.2 = localhost de la machine hôte
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Fond de carte (DEC-30, en test) : osm (défaut, Leaflet + tuiles OpenStreetMap)
# ou lfmaps (MapLibre GL + tuiles vectorielles LFMaps, sans clé, WebGL requis)
# EXPO_PUBLIC_MAP_PROVIDER=lfmaps
